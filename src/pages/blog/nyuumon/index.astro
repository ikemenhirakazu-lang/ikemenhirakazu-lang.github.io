---
// Claude Code入門シリーズのまとめページ。全8回をここに先に並べておく。
// 未公開の回も「準備中」で出す(読者が全体の道のりを先に見られるように)。
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { NYUUMON, SITE_TITLE } from '../../../consts';

const posts = (await getCollection('blog')).filter(
	(post) => !post.data.draft && post.data.series === NYUUMON.key,
);
const byEpisode = new Map(posts.map((p) => [p.data.episode, p]));

// 目次(consts.ts)を主にして、公開済みの回だけ記事の中身を差し込む
const rows = NYUUMON.episodes.map((ep) => ({ ...ep, post: byEpisode.get(ep.n) }));
const published = rows.filter((r) => r.post).length;

const title = `${NYUUMON.label}(全${NYUUMON.total}回)`;
const description = `${NYUUMON.lead} いまのところ${published}回まで公開しています。`;
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`${title} | ${SITE_TITLE}`} description={description} />
		<style>
			.series-head {
				margin-bottom: 1.8em;
			}
			.series-head h1 {
				margin-bottom: 0.35em;
			}
			.series-head p {
				margin: 0;
				color: var(--sub);
				line-height: 1.85;
			}
			.progress {
				display: inline-block;
				margin-top: 0.9em;
				padding: 0.3em 0.9em;
				border: 1px solid var(--safety);
				border-radius: 999px;
				background: var(--safety-soft);
				font-size: 0.85em;
			}
			ul.eps {
				display: flex;
				flex-direction: column;
				gap: 1rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.ep {
				display: flex;
				gap: 1.1rem;
				align-items: flex-start;
				background: var(--card);
				border: 1px solid var(--line);
				border-radius: 14px;
				padding: 1.1em 1.3em;
				text-decoration: none;
				color: inherit;
				transition: 0.15s ease;
			}
			a.ep:hover {
				transform: translateY(-2px);
				box-shadow: var(--box-shadow);
				border-color: var(--safety);
			}
			a.ep:hover .ep-title {
				color: var(--link);
			}
			.ep.soon {
				background: transparent;
				border-style: dashed;
			}
			.no {
				flex: 0 0 auto;
				display: flex;
				align-items: center;
				justify-content: center;
				width: 2.4em;
				height: 2.4em;
				border-radius: 50%;
				background: var(--safety);
				color: #2b2f36;
				font-family: var(--font-display);
				font-weight: 800;
				line-height: 1;
			}
			.ep.soon .no {
				background: var(--line);
				color: var(--sub);
			}
			.ep-body {
				flex: 1 1 auto;
				min-width: 0;
			}
			.ep-title {
				margin: 0;
				font-size: 1.05em;
				line-height: 1.55;
			}
			.ep.soon .ep-title {
				color: var(--sub);
			}
			.ep-meta {
				margin: 0.4em 0 0;
				color: var(--sub);
				font-size: 0.85em;
			}
			.ep-thumb {
				flex: 0 0 160px;
			}
			.ep-thumb img {
				display: block;
				width: 100%;
				height: auto;
				border-radius: 8px;
			}
			@media (max-width: 620px) {
				.ep-thumb {
					display: none;
				}
			}
			.back {
				display: inline-block;
				margin-top: 2.2rem;
				color: var(--sub);
				font-size: 0.9em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<div class="series-head">
					<h1>{title}</h1>
					<p>{NYUUMON.lead}</p>
					<p>
						書いているのは土木一筋30年の会社員です。自分が実際にやった順に、画面つきで書いていきます。
						上から順に読んでください。
					</p>
					<span class="progress">全{NYUUMON.total}回のうち、{published}回まで公開しています</span>
				</div>

				<ul class="eps">
					{
						rows.map((r) =>
							r.post ? (
								<li>
									<a class="ep" href={`/blog/${r.post.id}/`}>
										<span class="no">{r.n}</span>
										<div class="ep-body">
											<h2 class="ep-title">{r.post.data.title}</h2>
											<p class="ep-meta">
												第{r.n}回 ・ <FormattedDate date={r.post.data.pubDate} />
											</p>
										</div>
										{r.post.data.heroImage && (
											<div class="ep-thumb">
												<Image
													width={320}
													height={168}
													src={r.post.data.heroImage}
													alt={r.post.data.heroImageAlt ?? ''}
												/>
											</div>
										)}
									</a>
								</li>
							) : (
								<li>
									<div class="ep soon">
										<span class="no">{r.n}</span>
										<div class="ep-body">
											<h2 class="ep-title">{r.title}</h2>
											<p class="ep-meta">第{r.n}回 ・ 準備中</p>
										</div>
									</div>
								</li>
							),
						)
					}
				</ul>

				<a class="back" href="/blog/">← 記事一覧へ</a>
			</section>
		</main>
		<Footer />
	</body>
</html>
