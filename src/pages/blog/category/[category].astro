---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { CATEGORIES } from '../../../consts';

// カテゴリは consts.ts で定義した分だけページを作る。
export async function getStaticPaths() {
	return CATEGORIES.map((category) => ({
		params: { category: category.slug },
		props: { category },
	}));
}

const { category } = Astro.props;

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft && post.data.category === category.slug)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`${category.label} | AIよくばり日記`} description={category.description} />
		<style>
			.page-title {
				margin-bottom: 1.2em;
			}
			.page-title p {
				color: var(--sub);
				margin: 0;
				font-size: 0.92em;
			}
			ul.post-list {
				display: flex;
				flex-direction: column;
				gap: 1.2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul.post-list li a {
				display: block;
				background: var(--card);
				border: 1px solid var(--line);
				border-radius: 14px;
				padding: 1.2em 1.4em;
				text-decoration: none;
				transition: 0.15s ease;
			}
			ul.post-list li a:hover {
				transform: translateY(-2px);
				box-shadow: var(--box-shadow);
				border-color: var(--safety);
			}
			.title {
				margin: 0 0 0.3rem 0;
				color: var(--ink);
				line-height: 1.5;
				font-size: 1.15em;
			}
			.date {
				margin: 0;
				color: var(--sub);
				font-size: 0.85em;
			}
			ul.post-list li a:hover .title {
				color: var(--link);
			}
			.empty {
				color: var(--sub);
			}
			.other-categories {
				margin-top: 2.5rem;
				padding-top: 1.2rem;
				border-top: 1px solid var(--line);
			}
			.other-categories p {
				color: var(--sub);
				font-size: 0.9em;
				margin: 0 0 0.6rem 0;
			}
			.other-categories ul {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.other-categories a {
				display: inline-block;
				padding: 0.4em 0.9em;
				border: 1px solid var(--line);
				border-radius: 999px;
				text-decoration: none;
				color: var(--sub);
				font-size: 0.9em;
			}
			.other-categories a:hover {
				background: var(--safety-soft);
				color: var(--ink);
				border-color: var(--safety);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<div class="page-title">
					<h1>{category.label}</h1>
					<p>{category.description}</p>
				</div>
				{
					posts.length === 0 ? (
						<p class="empty">
							このテーマの記事はまだありません。<a href="/blog/">記事一覧</a>から他の記事を見てみてください。
						</p>
					) : (
						<ul class="post-list">
							{posts.map((post) => (
								<li>
									<a href={`/blog/${post.id}/`}>
										<h2 class="title">{post.data.title}</h2>
										<p class="date">
											<FormattedDate date={post.data.pubDate} />
										</p>
									</a>
								</li>
							))}
						</ul>
					)
				}
				<div class="other-categories">
					<p>ほかのテーマ</p>
					<ul>
						{
							CATEGORIES.filter((c) => c.slug !== category.slug).map((c) => (
								<li>
									<a href={`/blog/category/${c.slug}/`}>{c.label}</a>
								</li>
							))
						}
						<li><a href="/blog/">すべての記事</a></li>
					</ul>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
