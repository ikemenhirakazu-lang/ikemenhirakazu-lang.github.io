---
// Claude Code入門シリーズの案内。記事の頭(place="top")と末尾(place="bottom")に置く。
// 目次は consts.ts の NYUUMON。まだ公開していない回は、押せない「準備中」で出す。
import { getCollection } from 'astro:content';
import { NYUUMON } from '../consts';

interface Props {
	episode: number;
	place: 'top' | 'bottom';
}
const { episode, place } = Astro.props;

const posts = (await getCollection('blog')).filter(
	(post) => !post.data.draft && post.data.series === NYUUMON.key,
);
const byEpisode = new Map(posts.map((p) => [p.data.episode, p]));

// 前後の回。公開済みならタイトルとリンク、まだなら目次の仮タイトルと「準備中」
const at = (n: number) => {
	const plan = NYUUMON.episodes.find((e) => e.n === n);
	if (!plan) return null;
	const post = byEpisode.get(n);
	return {
		n,
		title: post?.data.title ?? plan.title,
		href: post ? `/blog/${post.id}/` : null,
	};
};
const prev = at(episode - 1);
const next = at(episode + 1);
---

{
	place === 'top' ? (
		<p class="series-top">
			<a href={NYUUMON.path}>{NYUUMON.label}</a>
			<span class="count">
				第{episode}回 / 全{NYUUMON.total}回
			</span>
		</p>
	) : (
		<nav class="series-bottom" aria-label="シリーズの前後">
			<p class="series-bottom-head">
				{NYUUMON.label}(全{NYUUMON.total}回)
			</p>
			<ul>
				{prev &&
					(prev.href ? (
						<li>
							<a href={prev.href}>
								<span class="dir">← 前の回</span>
								<span class="ttl">
									第{prev.n}回 {prev.title}
								</span>
							</a>
						</li>
					) : (
						<li>
							<span class="soon">
								<span class="dir">← 前の回</span>
								<span class="ttl">
									第{prev.n}回 {prev.title}(準備中)
								</span>
							</span>
						</li>
					))}
				{next &&
					(next.href ? (
						<li>
							<a href={next.href}>
								<span class="dir">次の回 →</span>
								<span class="ttl">
									第{next.n}回 {next.title}
								</span>
							</a>
						</li>
					) : (
						<li>
							<span class="soon">
								<span class="dir">次の回 →</span>
								<span class="ttl">
									第{next.n}回 {next.title}(準備中)
								</span>
							</span>
						</li>
					))}
			</ul>
			<a class="toc" href={NYUUMON.path}>
				シリーズの目次を見る(全{NYUUMON.total}回)
			</a>
		</nav>
	)
}

<style>
	/* ── 記事の頭に置く1行 ── */
	.series-top {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5em 0.8em;
		margin: 0 0 1.8em;
		padding: 0.6em 1em;
		border: 1px solid var(--line);
		border-left: 6px solid var(--safety);
		border-radius: 8px;
		background: var(--card);
		font-size: 0.9em;
	}
	.series-top a {
		font-family: var(--font-display);
		font-weight: 800;
		text-decoration: none;
		color: var(--ink);
	}
	.series-top a:hover {
		color: var(--link);
		text-decoration: underline;
	}
	.series-top .count {
		padding: 0.15em 0.7em;
		border-radius: 999px;
		background: var(--safety-soft);
		color: var(--sub);
		font-size: 0.9em;
		white-space: nowrap;
	}

	/* ── 記事の末尾に置く前後ナビ ── */
	.series-bottom {
		margin: 3em 0 1em;
		padding-top: 1.4em;
		border-top: 1px solid var(--line);
	}
	.series-bottom-head {
		margin: 0 0 0.9em;
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 1em;
	}
	.series-bottom ul {
		display: flex;
		flex-direction: column;
		gap: 0.7em;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.series-bottom li a,
	.series-bottom li .soon {
		display: block;
		padding: 0.9em 1.1em;
		border: 1px solid var(--line);
		border-radius: 12px;
		background: var(--card);
		text-decoration: none;
		color: inherit;
		transition: 0.15s ease;
	}
	.series-bottom li a:hover {
		border-color: var(--safety);
		box-shadow: var(--box-shadow);
		transform: translateY(-2px);
	}
	.series-bottom li .soon {
		background: transparent;
		border-style: dashed;
		color: var(--sub);
	}
	.series-bottom .dir {
		display: block;
		margin-bottom: 0.25em;
		color: var(--sub);
		font-size: 0.8em;
	}
	.series-bottom .ttl {
		display: block;
		font-family: var(--font-display);
		font-weight: 700;
		line-height: 1.6;
	}
	.series-bottom li a:hover .ttl {
		color: var(--link);
	}
	.series-bottom .toc {
		display: inline-block;
		margin-top: 1.1em;
		font-size: 0.92em;
	}
</style>
