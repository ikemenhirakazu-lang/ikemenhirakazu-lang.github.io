---
// 吹き出し。AIとのやりとりや、その場の一言を見せるのに使う。
// who: kuro = クロさん(ブログのAI相棒) / mil = ミルさん(ダイエット) / boss = ボス
// 顔の画像がある人は preset の icon に入れておく(記事側で毎回渡さなくていい)。
// まだ絵が無い人は頭文字の丸で出る。icon を渡せばその場で差し替わる。
interface Props {
	who?: 'kuro' | 'mil' | 'boss';
	name?: string;
	icon?: string;
}

const { who = 'kuro', name, icon } = Astro.props;

const preset = {
	kuro: { label: 'クロさん', initial: 'ク', side: 'left', icon: '/blog-img/char/kuro.png' },
	mil: { label: 'ミルさん', initial: 'ミ', side: 'left', icon: '/blog-img/char/mil.png' },
	boss: { label: 'ボス', initial: 'ボ', side: 'right', icon: '/blog-img/char/boss.png' },
} as const;
const { label, initial, side, icon: presetIcon } = preset[who];
const speaker = name ?? label;
const face = icon ?? presetIcon;
---

<div class:list={['balloon', who, side]}>
	<div class="face">
		{
			face ? (
				<img src={face} alt="" width="52" height="52" />
			) : (
				<span class="initial" aria-hidden="true">
					{initial}
				</span>
			)
		}
		<span class="name">{speaker}</span>
	</div>
	<div class="bubble">
		<slot />
	</div>
</div>

<style>
	.balloon {
		display: flex;
		align-items: flex-start;
		gap: 0.9em;
		margin: 1.8em 0;
	}
	.balloon.right {
		flex-direction: row-reverse;
	}
	.face {
		flex-shrink: 0;
		width: 56px;
		text-align: center;
	}
	.face img {
		display: block;
		width: 52px;
		height: 52px;
		border-radius: 50%;
		object-fit: cover;
		margin: 0 auto;
		border: 2px solid var(--line);
	}
	.initial {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 52px;
		height: 52px;
		margin: 0 auto;
		border-radius: 50%;
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 1.25em;
		color: #fff;
	}
	.kuro .initial {
		background: #3a4250;
	}
	.mil .initial {
		background: #4a90a4;
	}
	.boss .initial {
		background: var(--safety);
		color: #2b2f36;
	}
	.name {
		display: block;
		margin-top: 0.25em;
		font-size: 0.72em;
		color: var(--sub);
		line-height: 1.3;
		white-space: nowrap;
	}
	.bubble {
		position: relative;
		flex: 1;
		padding: 0.9em 1.15em;
		background: var(--card);
		border: 1px solid var(--line);
		border-radius: 12px;
		font-size: 0.97em;
	}
	/* しっぽ。枠線ぶんを2枚重ねで作る */
	.bubble::before,
	.bubble::after {
		content: '';
		position: absolute;
		top: 17px;
		border: 9px solid transparent;
	}
	.left .bubble::before {
		left: -18px;
		border-right-color: var(--line);
	}
	.left .bubble::after {
		left: -16px;
		border-right-color: var(--card);
	}
	.right .bubble::before {
		right: -18px;
		border-left-color: var(--line);
	}
	.right .bubble::after {
		right: -16px;
		border-left-color: var(--card);
	}
	.boss .bubble {
		background: var(--safety-soft);
	}
	.boss .bubble::after {
		border-left-color: var(--safety-soft);
	}
	.bubble :global(> :first-child) {
		margin-top: 0;
	}
	.bubble :global(> :last-child) {
		margin-bottom: 0;
	}
	@media (max-width: 520px) {
		.face {
			width: 44px;
		}
		.face img,
		.initial {
			width: 42px;
			height: 42px;
			font-size: 1.05em;
		}
	}
</style>
