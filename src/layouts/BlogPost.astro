---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import PrNotice from '../components/PrNotice.astro';
import Toc from '../components/Toc.astro';
import { categoryLabel } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & {
	// 記事ページからのみ渡る。固定ページ(プロフィール等)では未指定。
	headings?: { depth: number; slug: string; text: string }[];
};

const { title, description, pubDate, updatedDate, heroImage, affiliate, category, headings } =
	Astro.props;

// category があるものだけ「記事」とみなす。固定ページ(プロフィール等)は対象外。
const isPost = Boolean(category);
const site = Astro.site!;
const pageUrl = new URL(Astro.url.pathname, site).href;
const iso = (d: Date) => new Date(d).toISOString();

// パンくず: ホーム > ブログ > カテゴリ > 記事タイトル
const crumbs = isPost
	? [
			{ name: 'ホーム', url: new URL('/', site).href },
			{ name: 'ブログ', url: new URL('/blog/', site).href },
			{ name: categoryLabel(category!), url: new URL(`/blog/category/${category}/`, site).href },
			{ name: title, url: pageUrl },
		]
	: [];

const breadcrumbLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: crumbs.map((c, i) => ({
		'@type': 'ListItem',
		position: i + 1,
		name: c.name,
		item: c.url,
	})),
};

const articleLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	datePublished: iso(pubDate),
	dateModified: iso(updatedDate ?? pubDate),
	inLanguage: 'ja',
	mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
	author: {
		'@type': 'Person',
		name: 'ジンとニックのボス',
		url: new URL('/about/', site).href,
	},
	publisher: {
		'@type': 'Organization',
		name: 'AIよくばり日記',
		url: site.href,
	},
};
---

<html lang="ja">
	<head>
		<!-- アイキャッチがある記事は、SNSに出る画像もそれにする(無い記事はサイト共通のogp.png) -->
		<BaseHead title={title} description={description} image={heroImage} />
		{
			isPost && (
				<Fragment>
					<script
						type="application/ld+json"
						is:inline
						set:html={JSON.stringify(articleLd)}
					/>
					<script
						type="application/ld+json"
						is:inline
						set:html={JSON.stringify(breadcrumbLd)}
					/>
				</Fragment>
			)
		}
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			/* パンくず。読者の現在地と、検索エンジンへのサイト構造の両方に効く */
			.breadcrumb {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: 1em 1em 0;
				font-size: 0.82em;
				color: var(--sub);
			}
			.breadcrumb ol {
				display: flex;
				flex-wrap: wrap;
				gap: 0.2em 0.5em;
				margin: 0;
				padding: 0;
				list-style: none;
				line-height: 1.7;
			}
			.breadcrumb li + li::before {
				content: '›';
				margin-right: 0.5em;
				color: var(--line);
			}
			.breadcrumb a {
				color: var(--sub);
				text-decoration: none;
			}
			.breadcrumb a:hover {
				color: var(--ink);
				text-decoration: underline;
			}
			/* 最後(いま見ているページ)はタイトルが長いので、はみ出さないよう省略する */
			.breadcrumb li:last-child span {
				display: inline-block;
				max-width: 22em;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
				vertical-align: bottom;
				color: var(--ink);
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			.category-link {
				display: inline-block;
				margin-top: 0.6em;
				padding: 0.3em 0.9em;
				border: 1px solid var(--line);
				border-radius: 999px;
				color: var(--sub);
				text-decoration: none;
				font-size: 0.85em;
			}
			.category-link:hover {
				background: var(--safety-soft);
				color: var(--ink);
				border-color: var(--safety);
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			{
				isPost && (
					<nav class="breadcrumb" aria-label="パンくずリスト">
						<ol>
							{crumbs.map((c, i) => (
								<li>
									{i === crumbs.length - 1 ? (
										<span aria-current="page">{c.name}</span>
									) : (
										<a href={c.url}>{c.name}</a>
									)}
								</li>
							))}
						</ol>
					</nav>
				)
			}
			<article>
				<div class="hero-image">
					{/* アイキャッチは 1200×630。比率を崩さないよう高さもその割合で指定する */}
				{heroImage && <Image width={1020} height={536} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										最終更新: <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						{
							category && (
								<a class="category-link" href={`/blog/category/${category}/`}>
									{categoryLabel(category)}
								</a>
							)
						}
						<hr />
					</div>
					{affiliate && <PrNotice />}
					<Toc headings={headings} />
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
